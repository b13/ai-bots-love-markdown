# Add link rel="alternate" to HTML pages for Markdown discovery
# The middleware will convert the page to Markdown when this tag is present
# and the request has Accept: text/markdown header or type=2026
page.headerData.1736000 = TEXT
page.headerData.1736000 {
    if.isTrue = {$ai_bots_love_markdown.enableDiscoveryTag}
    typolink {
        parameter.data = page:uid
        additionalParams = &type=2026
        forceAbsoluteUrl = 1
        returnLast = url
    }
    wrap = <link rel="alternate" type="text/markdown" href="|" title="Markdown version" />
}

# Make MarkdownInclude / MarkdownExclude partials available to integrators
# without requiring manual partialRootPaths configuration in their site set.
lib.contentElement.partialRootPaths.1736001 = EXT:ai_bots_love_markdown/Resources/Private/Partials/
page.10.partialRootPaths.1736001 = EXT:ai_bots_love_markdown/Resources/Private/Partials/

# llms.txt (https://llmstxt.org/) on the site root, mapped to /llms.txt by the
# PageType route enhancer. Opt-in: the page type is only registered when
# ai_bots_love_markdown.llmsTxt.enabled is set, so the typeNum stays free
# otherwise. The controller additionally answers 404 unless the feature is
# enabled and the page is the site root.
[site("settings").get("ai_bots_love_markdown.llmsTxt.enabled")]
aiBotsLoveMarkdownLlmsTxt = PAGE
aiBotsLoveMarkdownLlmsTxt {
    typeNum = {$ai_bots_love_markdown.llmsTxt.typeNum}
    config {
        disableAllHeaderCode = 1
        additionalHeaders.10.header = Content-Type: text/plain; charset=utf-8
        admPanel = 0
        debug = 0
    }
    10 = USER
    10.userFunc = B13\AiBotsLoveMarkdown\LlmsTxt\LlmsTxtController->render
}
[END]
