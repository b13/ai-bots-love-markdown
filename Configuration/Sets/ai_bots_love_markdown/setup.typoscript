# Add link rel="alternate" to HTML pages for Markdown discovery
# The middleware will convert the page to Markdown when this tag is present
# and the request has Accept: text/markdown header or type=2026
page.headerData.1736000 = TEXT
page.headerData.1736000 {
    if.isTrue = {$ai_bots_love_markdown.enableDiscoveryTag}
    typolink {
        parameter.data = page:uid
        additionalParams = &type=2026
        forceAbsoluteUrl = 1
        returnLast = url
    }
    wrap = <link rel="alternate" type="text/markdown" href="|" title="Markdown version" />
}
