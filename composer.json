{
	"name": "b13/ai-bots-love-markdown",
	"type": "typo3-cms-extension",
	"description": "Serve page content as Markdown for AI bots",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": "^8.2",
		"typo3/cms-core": "^13.4 || ^14.0",
		"league/html-to-markdown": "^5.1"
	},
	"require-dev": {
		"typo3/testing-framework": "^8.2 || ^9.1",
		"phpunit/phpunit": "^10.5 || ^11.3"
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "ai_bots_love_markdown"
		}
	},
	"autoload": {
		"psr-4": {
			"B13\\AiBotsLoveMarkdown\\": "Classes/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"B13\\AiBotsLoveMarkdown\\Tests\\": "Tests/"
		}
	},
	"scripts": {
		"test:unit": "phpunit -c Build/phpunit/UnitTests.xml"
	},
	"config": {
		"allow-plugins": {
			"typo3/class-alias-loader": true,
			"typo3/cms-composer-installers": true
		}
	}
}
